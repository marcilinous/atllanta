# Server-side only — set these in Vercel, never commit real values
SUPABASE_URL=https://nburswxjpukntgdwuyme.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Email delivery (Resend) — drains queued notifications from the event worker
RESEND_API_KEY=
RESEND_FROM="Atllanta <notifications@atllanta.app>"

# Shared secret for the event worker cron (/api/event-processor).
# Vercel Cron sends it automatically as a Bearer token when set; external
# cron providers can pass it as ?key=<secret>. Leave blank to run unguarded.
CRON_SECRET=

# Google Calendar + Meet (optional — booking works without these, just no Meet link)
# 1. Create a Google Cloud project → enable Calendar API
# 2. Create a service account → download JSON key
# 3. For Workspace: enable domain-wide delegation, add Calendar scope
# 4. Share manager's calendar with the service account email
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
