# Server-side only — set these in Vercel, never commit real values
SUPABASE_URL=https://nburswxjpukntgdwuyme.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Public — safe in a browser bundle, RLS is what protects the data. The
# browser client (public/js/supabase.js) and the Next.js SSR client
# (src/lib/supabase/server.ts, middleware.ts) share these so both stacks read
# and write the same session cookie (TRANSITION.md, Phase 2 item 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Drizzle (Phase 0, read-only/introspection use — src/db/index.ts). Use the
# Supabase pooled (transaction pooler) connection string, port 6543, not the
# direct 5432 connection. Leave empty locally; without it, `npm run build`,
# `npm run typecheck` and `npm run test:unit` still pass, and /health renders
# a "database not configured" state instead of throwing.
DATABASE_URL=

# Google Calendar + Meet (optional — booking works without these, just no Meet link)
# 1. Create a Google Cloud project → enable Calendar API
# 2. Create a service account → download JSON key
# 3. For Workspace: enable domain-wide delegation, add Calendar scope
# 4. Share manager's calendar with the service account email
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
